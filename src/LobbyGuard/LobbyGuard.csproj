<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>com.github.lethalcompanymodding.lobbyguard</AssemblyName>
    <AssemblyTitle>LobbyGuard</AssemblyTitle>
    <RootNamespace>LobbyGuard</RootNamespace>
    <RepositoryUrl>https://github.com/LethalCompanyModding/LobbyGuard</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Publicize Include="Unity.Netcode.Runtime" />
    <Publicize Include="Facepunch Transport for Netcode for GameObjects" />
    <Publicize Include="DissonanceVoip" />
    <Publicize Include="Facepunch.Steamworks.Win64" />
    <InternalsVisibleTo Include="LobbyGuard.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>LobbyGuard</ThunderstoreName>
    <ThunderstoreDescription>Stops a bad client from crashing or freezing your lobby. Only the host needs it.</ThunderstoreDescription>
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>mods;bepinex</ThunderstoreCategories>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
  </ItemGroup>
</Project>
